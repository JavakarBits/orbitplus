# Placeholder-only local development template. Do not put secrets in this file.
# Copy values to your environment or replace the *_FILE paths with mounted local secret files.
APP_ENV=development

RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE=tripdetails.refresh.worker
RABBITMQ_EXCHANGE=tripdetails.refresh
RABBITMQ_ROUTING_KEY=tripdetails.refresh
RABBITMQ_USERNAME=local-rabbitmq-username
RABBITMQ_PASSWORD=local-rabbitmq-password
# Maximum unacknowledged RabbitMQ deliveries per consumer channel; independent of WORKER_CONCURRENCY.
RABBITMQ_PREFETCH=10

# Bits base URL. The Worker constructs temporary direct credentials per message.
BITS_BASE_URL=http://localhost:8081

# Existing OrbitPlus/Master destination contract.
ORBITPLUS_URL=http://localhost:8082
ORBITPLUS_BEARER_TOKEN_FILE=/path/to/local/orbitplus-token

# Maximum simultaneous fetch/submit operations in this Worker process; independent of RABBITMQ_PREFETCH.
WORKER_CONCURRENCY=10
WORKER_HTTP_TIMEOUT=15s
