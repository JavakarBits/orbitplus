APP_ENV=development

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_QUEUE=orbitplus.tripdetails.refresh.worker
RABBITMQ_EXCHANGE=tripdetails.refresh
RABBITMQ_ROUTING_KEY=tripdetails.refresh 
RABBITMQ_PREFETCH=1

# Orbit credential service
ORBIT_URL=http://localhost:8081
ORBIT_NAMESPACE_CODE=ezeeinfo
ORBIT_ACCESS_TOKEN=ASKJFEHP79Q69NZP

# OrbitPlus Master
ORBITPLUS_URL=http://localhost:8082

# BITS
BITS_BASE_URL=https://dev-stage.ezeebits.in/busservices

# Worker processing
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAYS=2s,5s
WORKER_HTTP_TIMEOUT=15s

# Worker health API
HEALTH_API_HOST=0.0.0.0
HEALTH_API_PORT=8080

# Rate limiting
WORKER_BITS_RATE_LIMIT=10/1m

# Dragonfly
DRAGONFLY_ADDRESS=localhost:6379
DRAGONFLY_PASSWORD=
DRAGONFLY_DATABASE=0
DRAGONFLY_CONNECTION_TIMEOUT=5s
