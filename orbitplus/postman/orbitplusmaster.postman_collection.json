{
  "info": {
    "name": "orbitplusmaster",
    "description": "TripDetails ingestion, health, and persisted Search/Busmap API requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST TripDetails",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"referenceId\": \"ed1a859fee57\",\n  \"actionType\": \"search\",\n  \"operatorCode\": \"bits\",\n  \"fromCode\": \"STF17D52\",\n  \"toCode\": \"STF17D51\",\n  \"tripDate\": \"2026-08-20\",\n  \"orbitResponse\": {\n    \"status\": 1,\n    \"data\": [{\n      \"tripCode\": \"2N38731S260820D\",\n      \"tripStageCode\": \"2N38731S260820D2T1\",\n      \"travelDate\": \"2026-08-20\",\n      \"fromStation\": { \"code\": \"STF17D52\" },\n      \"toStation\": { \"code\": \"STF17D51\" }\n    }]\n  }\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "http://localhost:8082/api/tripdetails"
      }
    },
    {
      "name": "POST TripDetails DLQ Notification",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"referenceId\": \"ed1a859fee57\",\n  \"failureMessage\": \"Worker could not process the searchbusmap job after retry attempts\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "http://localhost:8082/orbitplus/api/tripdetails/dlq"
      }
    },
    {
      "name": "POST Orionmax Inventory Change Event",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action_type\": \"SEARCH_Q3\",\n  \"activity_type\": \"daily-job\",\n  \"data\": [\n    {\n      \"refid\": \"ed1a859fee57\",\n      \"doj\": \"2026-09-04 00:00:00\",\n      \"source\": \"STF2CD129\",\n      \"destination\": \"ST1984513H\",\n      \"operatorcode\": \"aonetrans\",\n      \"type\": \"SEARCH\",\n      \"schedulecode\": \"NA\",\n      \"tripcode\": \"2N38731S260904D\"\n    }\n  ],\n  \"zone\": \"r3bits\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "http://localhost:8082/api/orionmax/inventory/events?activity_type=daily-job",
        "description": "Each published Worker job includes zoneURL derived from the inbound zone. Example: r3bits resolves to http://app.r3.ezeebits.com. All supplied and unrecognized activity types are queued as searchbusmap. data[].tripcode is optional; when supplied it is published as Worker tripCode, otherwise a non-NA schedulecode may resolve it from schedule metadata. Namespace credentials are never included in the message."
      }
    },
    { "name": "GET Health", "request": { "method": "GET", "url": "http://localhost:8082/health" } },
    {
      "name": "GET Trip Analyzer History (protected UI session)",
      "request": {
        "method": "GET",
        "description": "Queue lifecycle history from queue_metrix. Requires operatorCode plus a tripCode or at least one of tripDate, fromStation, toStation. For new Orionmax entries, tripCode is optional and all activities use searchbusmap, so include route selectors to return rows without a trip code. Requires an authenticated protected UI session.",
        "url": "http://localhost:8082/orbitplus/api/admin/trip-history?operatorCode=bits&tripCode=2N38731S260820D&tripDate=2026-08-20&fromStation=STF17D52&toStation=STF17D51"
      }
    },
    {
      "name": "GET Search (persisted)",
      "request": {
        "method": "GET",
        "url": "http://localhost:8082/orbitplus/api/3.0/json/bits/demo-user/demo-token/search/STF17D52/STF1GI77/2026-08-20"
      }
    },
    {
      "name": "GET Busmap (persisted)",
      "request": {
        "method": "GET",
        "url": "http://localhost:8082/orbitplus/api/3.0/json/bits/demo-user/demo-token/busmap/2N38731S260820D/STF17D52/STF1GI77/2026-08-20"
      }
    },
    {
      "name": "POST UI Login (required before protected APIs)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [{ "key": "access_token", "value": "{{orbitplus_ui_access_token}}", "type": "text" }]
        },
        "url": "http://localhost:8082/orbitplus/login",
        "description": "Set the orbitplus_ui_access_token Postman variable to ORBITPLUS_UI_ACCESS_TOKEN. Postman then retains the signed session cookie for protected API requests."
      }
    },
    {
      "name": "POST UI Logout",
      "request": { "method": "POST", "url": "http://localhost:8082/orbitplus/logout" }
    },
    {
      "name": "GET Queue Jobs Report (protected)",
      "request": { "method": "GET", "url": "http://localhost:8082/orbitplus/api/reports/queue-jobs" }
    },
    {
      "name": "GET Queue Dashboard Summary (protected)",
      "request": { "method": "GET", "url": "http://localhost:8082/orbitplus/api/dashboard/queue-summary" }
    },
    {
      "name": "GET System Health (protected)",
      "request": { "method": "GET", "url": "http://localhost:8082/orbitplus/api/dashboard/system-health" }
    },
    {
      "name": "GET Admin Dashboard (protected)",
      "request": { "method": "GET", "url": "http://localhost:8082/orbitplus/api/admin/dashboard" }
    },
    {
      "name": "GET Cache Keys (protected)",
      "request": {
        "method": "GET",
        "url": "http://localhost:8082/orbitplus/api/cache?cursor=0&limit=100&category=all",
        "description": "Lists cache keys only. It does not return values. category may be all, trip, stage, busmap, or other."
      }
    },
    {
      "name": "GET Cache Value (protected)",
      "request": {
        "method": "GET",
        "url": "http://localhost:8082/orbitplus/api/cache/value?key=trip%3Abits%3A2N38731S260820D",
        "description": "Replace the key query parameter with a key returned by GET Cache Keys."
      }
    },
    {
      "name": "GET RabbitMQ Snapshot (protected)",
      "request": { "method": "GET", "url": "http://localhost:8082/orbitplus/api/rabbitmq" }
    },
    {
      "name": "GET Route Metadata (protected)",
      "request": {
        "method": "GET",
        "url": "http://localhost:8082/orbitplus/api/tables/route-metadata?operator=bits&travel=2026-08-20&from=STF17D52&to=STF1GI77"
      }
    },
    {
      "name": "GET Schedule Metadata (protected)",
      "request": {
        "method": "GET",
        "url": "http://localhost:8082/orbitplus/api/tables/schedule-metadata?operator=bits&schedule=SCH4A8734G&travel=2026-08-20"
      }
    },
    {
      "name": "POST Orionmax Inventory Events — All Activities",
      "description": "Each known activity has its own request. All are queued by Master as searchbusmap. tripcode is optional; add it to data[0] only when Orionmax provides it. Replace the sample reference IDs before sending requests to a shared environment.",
      "item": [
        { "name": "POST daily-job", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"activity_type\":\"daily-job\",\"data\":[{\"refid\":\"{{refid}}\",\"doj\":\"2026-09-04 00:00:00\",\"source\":\"STF2CD129\",\"destination\":\"ST1984513H\",\"operatorcode\":\"aonetrans\",\"schedulecode\":\"NA\",\"tripcode\":\"2N38731S260904D\"}],\"zone\":\"r3bits\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8082/api/orionmax/inventory/events?activity_type=daily-job" } },
        { "name": "POST ticket-tentative-block-cancel", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"activity_type\":\"ticket-tentative-block-cancel\",\"data\":[{\"refid\":\"{{refid}}\",\"doj\":\"2026-09-04 00:00:00\",\"source\":\"STF2CD129\",\"destination\":\"ST1984513H\",\"operatorcode\":\"aonetrans\",\"schedulecode\":\"NA\",\"tripcode\":\"2N38731S260904D\"}],\"zone\":\"r3bits\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8082/api/orionmax/inventory/events?activity_type=ticket-tentative-block-cancel" } },
