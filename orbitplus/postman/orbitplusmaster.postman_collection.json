        { "name": "POST quick-fare-change", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"activity_type\":\"quick-fare-change\",\"data\":[{\"refid\":\"{{refid}}\",\"doj\":\"2026-09-04 00:00:00\",\"source\":\"STF2CD129\",\"destination\":\"ST1984513H\",\"operatorcode\":\"aonetrans\",\"schedulecode\":\"NA\",\"tripcode\":\"2N38731S260904D\"}],\"zone\":\"r3bits\"}", "options": { "raw": { "language": "json" } } }, "url": "http://localhost:8082/api/orionmax/inventory/events?activity_type=quick-fare-change" } },
