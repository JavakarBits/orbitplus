# Local-only Master runtime configuration. This file is ignored by Git.
# Use deployment environment variables or a secret manager in production; never commit credentials.
APP_ENV=development
MASTER_API_PORT=8082
ORBITPLUS_UI_ACCESS_TOKEN=EZEEORBITPLUS

# Dragonfly or Redis-compatible cache endpoint.

DRAGONFLY_ADDRESS=localhost:6379
DRAGONFLY_PASSWORD=
DRAGONFLY_DATABASE=0
DRAGONFLY_CONNECTION_TIMEOUT=5s

# Cassandra persistence.
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=orbitplus
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_CONNECTION_TIMEOUT=5s

# RabbitMQ publisher (split-key style, no RABBITMQ_URL needed).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
# RABBITMQ_VHOST=/
RABBITMQ_EXCHANGE=tripdetails.refresh

RABBITMQ_MANAGEMENT_USERNAME=guest
RABBITMQ_MANAGEMENT_PASSWORD=guest
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_MANAGEMENT_VHOST=/
RABBITMQ_MANAGEMENT_TIMEOUT=5s

# RabbitMQ Management API dashboard is optional and disabled here. To enable the
# master's internal queue dashboard, add RABBITMQ_MANAGEMENT_USERNAME and
# RABBITMQ_MANAGEMENT_PASSWORD (host reuses RABBITMQ_HOST, port defaults 15672).

# Periodic route refresh. Leave any required value blank to keep it disabled.
# Use 1m for local testing; use 1h in production.
# The supported zone code is stored in the Cassandra operators table.
# Keep the shared Orbit token in a secret manager in production. 
ORBIT_ROUTE_BASE_URL=http://localhost:8073/
ORBIT_ROUTE_ACCESS_TOKEN=ASKJFEHP79Q69NZP
ORBIT_ROUTE_TIMEOUT=5s
ORBIT_ROUTE_REFRESH_INTERVAL=1m
ORBIT_ROUTE_STALE_DURATION=1m

# Live BITS verification and shared per-zone quota.
# Keep this policy aligned with orbitplusworker/WORKER_BITS_RATE_LIMIT.
BITS_ZONE_BITS_URL=https://dev-stage.ezeebits.in
MASTER_BITS_RATE_LIMIT=10/1m
MASTER_BITS_RATE_LIMIT_OVERRIDES=